# Copy to .env.local. All of these are read on the server only (never sent to the browser).
# They are checked when the server starts (src/lib/env.ts): a wrong value stops the start with a message.

# Base URL of the NestJS backend, no trailing slash. Required: the storefront has no data of its own.
API_URL=http://localhost:4000/api

# Shared key sent to the backend as x-api-key. Must match the key set on the backend.
# Empty = the header is not sent.
API_KEY=

# How long to wait for one backend call, in milliseconds. Empty = 8000.
API_TIMEOUT_MS=

# How long catalogue and content answers (site, pages, products, collections, articles) are reused before
# the backend is asked again, in seconds. Empty = 300. 0 = ask on every request (no static pages).
CACHE_SECONDS=

# Public address of this storefront, no trailing slash, e.g. https://shop.example.com. Used for absolute links
# (share buttons). Empty = taken from each request, which makes article pages render per request instead of
# being generated ahead of time.
SITE_URL=

# Secret for POST /api/revalidate, which drops cached answers at once after a content change.
# At least 16 characters. Empty = that route is switched off.
REVALIDATE_SECRET=
