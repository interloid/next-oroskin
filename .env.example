# Copy to .env.local. All three are read on the server only (never sent to the browser).

# Base URL of the NestJS backend, no trailing slash, e.g. http://localhost:4000/api
# Empty = the built-in mock answers (no backend needed).
API_URL=

# Shared key sent to the backend as x-api-key. Must match the key set on the backend.
# Empty = the header is not sent.
API_KEY=

# How long to wait for one backend call, in milliseconds. Empty = 8000.
API_TIMEOUT_MS=
